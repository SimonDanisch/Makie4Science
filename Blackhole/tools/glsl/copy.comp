#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 256) in;
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer U4 { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) buffer O4 { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Args { uint64_t x; uint64_t y; };
layout(push_constant) uniform PC { uint64_t args; } pc;
void main() {
    Args a = Args(pc.args);
    uint i = gl_GlobalInvocationID.x;
    O4(a.y).v[i] = U4(a.x).v[i] + uvec4(1);
}
